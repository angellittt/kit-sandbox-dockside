{
  "packageManager": "pnpm@10.30.3",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "dev:no-docker": "turbo dev",
    "build": "turbo build",
    "compose:dev:up": "docker compose -f docker-compose-dev.yml up --build",
    "compose:dev:watch": "docker compose -f docker-compose-dev.yml watch",
    "compose:dev:down": "docker compose -f docker-compose-dev.yml down -v",
    "compose:up": "docker compose -f docker-compose.yml up --build",
    "compose:down": "docker compose -f docker-compose.yml down",
    "compose:test:up": "docker compose -f docker-compose-test.yml up --build",
    "compose:test:down": "docker compose -f docker-compose-test.yml down -v",
    "test": "turbo run test",
    "test:e2e": "./scripts/e2e-ci.sh",
    "test:e2e:ui": "./scripts/e2e-ui.sh",
    "test:projects": "vitest run",
    "test:projects:watch": "vitest --watch",
    "test:report": "turbo run test-report",
    "test:report:view": "pnpm test:report && open-cli packages/vitest-config/coverage/report/index.html",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run build --filter=@repo/vitest-config && tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{ts,tsx,js,jsx,json,css,md,yml,yaml}": [
      "prettier --write --ignore-unknown"
    ],
    "infra/**/*.tf": [
      "bash -c 'cd infra && terraform fmt -check'",
      "bash -c 'cd infra && terraform validate'"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^25.3.5",
    "eslint": "^10.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "open-cli": "^8.0.0",
    "prettier": "3.8.1",
    "turbo": "^2.8.12",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
