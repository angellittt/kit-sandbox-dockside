# Runs the whole monorepo's test suite in a container - used by
# docker-compose-test.yml. Unlike apps/api/Dockerfile and
# apps/web/Dockerfile (which `turbo prune` down to a single app for a
# lean production image), this keeps the full workspace since `pnpm
# test` fans out across every app/package via turbo.
ARG NODE_VERSION=24.14.0
FROM node:${NODE_VERSION}-alpine

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME/bin:$PNPM_HOME:$PATH"
# ca-certificates/openssl so anything the test suite talks to over HTTPS
# (registries, external APIs) works.
RUN apk add --no-cache ca-certificates openssl
RUN corepack enable
RUN corepack prepare pnpm@10.30.3 --activate

WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile

CMD ["pnpm", "test"]
