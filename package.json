{
  "packageManager": "pnpm@10.30.3",
  "private": true,
  "scripts": {
    "dev:no-docker": "turbo dev",
    "build": "turbo build",
    "compose:dev:up": "docker compose -f docker-compose-dev.yml up --build",
    "compose:up": "docker compose -f docker-compose.yml up --build",
    "test": "turbo run test",
    "test:projects": "vitest run",
    "test:projects:watch": "vitest --watch",
    "test:report": "turbo run test-report",
    "test:report:view": "pnpm test:report && open-cli packages/vitest-config/coverage/report/index.html"
  },
  "devDependencies": {
    "@repo/vitest-config": "workspace:*",
    "open-cli": "^8.0.0",
    "turbo": "^2.8.12",
    "vitest": "^4.0.18"
  }
}
